# Example environment variables for Notes Frontend (React)
# Copy to .env and adjust as needed.

# Optional: Base URL of backend API (not called yet; just logged for visibility)
REACT_APP_API_BASE=https://api.example.com

# Feature flags as a JSON array, e.g., ["experiments"]
REACT_APP_FEATURE_FLAGS=[]

# Enable experiments UI (true/false)
REACT_APP_EXPERIMENTS_ENABLED=false

# Additional environment variables available in the container (not used directly here)
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
